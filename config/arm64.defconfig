# Buildroot options for arm64

# Architecture and toolchain
BR2_aarch64=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/nerves-project/toolchains/releases/download/v15.3.0/nerves_toolchain_aarch64_nerves_linux_gnu-linux_${shell uname -m}-15.3.0-8DAF9F3.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-nerves-linux-gnu"

# Boot: GRUB
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="${NERVES_DEFCONFIG_DIR}/grub-embedded.cfg"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 squash4 fat part_msdos part_gpt normal efi_gop loadenv echo true test sleep search search_fs_uuid regexp"
BR2_PACKAGE_HOST_DOSFSTOOLS=y

# Platform tools
BR2_PACKAGE_DMIDECODE=y
BR2_PACKAGE_EFIBOOTMGR=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set

# System name and kernel
BR2_NERVES_SYSTEM_NAME="fostrom_system_arm64"
BR2_PACKAGE_FOSTROM_KERNEL_TARGET="arm64"
