# Busybox options for every target

# Terminal
CONFIG_TTY=y
CONFIG_STTY=y
CONFIG_RESET=y
CONFIG_CLEAR=y

# Text
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_LESS=y
CONFIG_VI=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_HEAD=y
CONFIG_WC=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_XARGS=y
CONFIG_DIFF=y
CONFIG_SEQ=y
CONFIG_TEST=y

# Processes and files
CONFIG_TOP=y
CONFIG_UPTIME=y
CONFIG_NPROC=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_WATCH=y
CONFIG_LSOF=y
CONFIG_FUSER=y
CONFIG_STAT=y
CONFIG_WHICH=y
CONFIG_WHOAMI=y
CONFIG_READLINK=y

# Disk usage
CONFIG_DU=y

# Network
CONFIG_PING=y
CONFIG_PING6=y
CONFIG_NSLOOKUP=y
CONFIG_TRACEROUTE=y
CONFIG_WGET=y
CONFIG_NETSTAT=y
CONFIG_FEATURE_NETSTAT_WIDE=y
CONFIG_FEATURE_NETSTAT_PRG=y
CONFIG_RFKILL=y

# Archives, dumps, checksums
CONFIG_TAR=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_XXD=y
CONFIG_HEXDUMP=y
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y

# Line editing, history, job control
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_HISTORY=1024
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_USERNAME_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_SH_HISTFILESIZE=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_HELP=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_CMDCMD=y

# Scripting
CONFIG_EXPR=y
CONFIG_PRINTF=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_REALPATH=y
CONFIG_MKTEMP=y
CONFIG_ENV=y

# USB
CONFIG_LSUSB=y

# Chroot
CONFIG_CHROOT=y

# More text and system tools
CONFIG_OD=y
CONFIG_STRINGS=y
CONFIG_NL=y
CONFIG_REV=y
CONFIG_FOLD=y
CONFIG_PASTE=y
CONFIG_COMM=y
CONFIG_SPLIT=y
CONFIG_PATCH=y
CONFIG_NC=y
CONFIG_TIME=y
CONFIG_IOSTAT=y
CONFIG_FLOCK=y
CONFIG_FEATURE_GREP_CONTEXT=y
