bcm2712-rpi-cm5l-cm5io.dtb               dtbs/broadcom/bcm2712-rpi-cm5l-cm5io.dtb      delta
bcm2712d0-rpi-5-b.dtb                    dtbs/broadcom/bcm2712d0-rpi-5-b.dtb           delta
bcm2712-d-rpi-5-b.dtb                    dtbs/broadcom/bcm2712-d-rpi-5-b.dtb           delta

# GPU firmware for Pi 3 class boards
start.elf                                rpi-firmware/start_x.elf                      delta
fixup.dat                                rpi-firmware/fixup_x.dat

# Crash log overlays, one for each family's address
overlays/ramoops.dtbo                    ramoops-pi3.dtbo
overlays/ramoops-pi4.dtbo                ramoops-pi4.dtbo

