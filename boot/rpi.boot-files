# Files on a Pi's boot partition, in the order an upgrade writes them: the
# name on the partition, the file under images/, and delta where an upgrade
# patches it against the other slot's copy

# Config, kernel, GPU firmware fixup
config.txt                               config.txt
kernel8.img                              Image                                         delta
fixup4.dat                               rpi-firmware/fixup4x.dat

# Device trees, BCM2837 and BCM2710: Pi 2B v1.2, Pi 3, CM3, Zero 2 W
bcm2710-rpi-2-b.dtb                      dtbs/broadcom/bcm2710-rpi-2-b.dtb             delta
bcm2710-rpi-3-b.dtb                      dtbs/broadcom/bcm2710-rpi-3-b.dtb             delta
bcm2710-rpi-3-b-plus.dtb                 dtbs/broadcom/bcm2710-rpi-3-b-plus.dtb        delta
bcm2710-rpi-cm0.dtb                      dtbs/broadcom/bcm2710-rpi-cm0.dtb             delta
bcm2710-rpi-cm3.dtb                      dtbs/broadcom/bcm2710-rpi-cm3.dtb             delta
bcm2710-rpi-zero-2.dtb                   dtbs/broadcom/bcm2710-rpi-zero-2.dtb          delta
bcm2710-rpi-zero-2-w.dtb                 dtbs/broadcom/bcm2710-rpi-zero-2-w.dtb        delta
bcm2837-rpi-3-a-plus.dtb                 dtbs/broadcom/bcm2837-rpi-3-a-plus.dtb        delta
bcm2710-rpi-3-a-plus.dtb                 dtbs/broadcom/bcm2837-rpi-3-a-plus.dtb        delta

# Device trees, BCM2711: Pi 4B, 400, CM4
bcm2711-rpi-4-b.dtb                      dtbs/broadcom/bcm2711-rpi-4-b.dtb             delta
bcm2711-rpi-400.dtb                      dtbs/broadcom/bcm2711-rpi-400.dtb             delta
bcm2711-rpi-cm4.dtb                      dtbs/broadcom/bcm2711-rpi-cm4.dtb             delta
bcm2711-rpi-cm4-io.dtb                   dtbs/broadcom/bcm2711-rpi-cm4-io.dtb          delta
bcm2711-rpi-cm4s.dtb                     dtbs/broadcom/bcm2711-rpi-cm4s.dtb            delta

# Device trees, BCM2712: Pi 5, 500, CM5
bcm2712-rpi-5-b.dtb                      dtbs/broadcom/bcm2712-rpi-5-b.dtb             delta
bcm2712-rpi-500.dtb                      dtbs/broadcom/bcm2712-rpi-500.dtb             delta
bcm2712-rpi-cm5-cm4io.dtb                dtbs/broadcom/bcm2712-rpi-cm5-cm4io.dtb       delta
bcm2712-rpi-cm5-cm5io.dtb                dtbs/broadcom/bcm2712-rpi-cm5-cm5io.dtb       delta
